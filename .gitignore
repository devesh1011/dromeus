# Python
*.py[cod]
.pytest_cache/
.ruff_cache
.venv/
__pycache__/
/dist/

# Local documentation
docs/
graphify-out
learning-records
lessons
reference

# Logs
logs/*.log

# Local formation dashboard runtime
.demo-cache/

# Misc
.DS_Store
misc/
tmp

# Local AWS instance credentials and connection state
aws

# Local credentials and machine configuration
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# New benchmark Python scripts stay local; tracked modules remain tracked.
/benchmarks/**/*.py

# M3 experiment tooling remains local.
/benchmarks/m3/

# Benchmark tests stay local; source-module tests remain tracked.
/tests/benchmarks/

# Keep logs and compact benchmark evidence in Git; keep model binaries external.
benchmarks/results/m2/**/*.safetensors
benchmarks/results/m2/**/*.pt
benchmarks/results/m2/**/*.pth
benchmarks/results/m2/**/*.npz
benchmarks/results/m2/**/*.tar.gz
benchmarks/results/m2/**/*.zip
benchmarks/results/m2/**/archives/
benchmarks/results/m2/**/provisioning/
benchmarks/results/m2/**/cifar-cache/
benchmarks/results/m2/nccl-reference/**/preflight/
benchmarks/results/m2/nccl-reference/**/aws/
benchmarks/results/m2/nccl-reference/**/cleanup/*
!benchmarks/results/m2/nccl-reference/**/cleanup/final-state.json
benchmarks/results/m2/nccl-reference/remediation-preflight-*/
benchmarks/results/m2/nccl-reference/campaign-*/

# Generated application-development runs are separate from the M2 submission.
benchmarks/results/local-data-validation/

# Keep M3 working experiments local; expose only the curated judge handoff.
/benchmarks/results/m3/*
!/benchmarks/results/m3/README.md
!/benchmarks/results/m3/milestone-requirements.md
!/benchmarks/results/m3/proposal-basis.json
!/benchmarks/results/m3/run-index.json
!/benchmarks/results/m3/artifact-availability.json
!/benchmarks/results/m3/file-manifest.json
!/benchmarks/results/m3/checksums.sha256
!/benchmarks/results/m3/results/
!/benchmarks/results/m3/configurations/
!/benchmarks/results/m3/audit/
!/benchmarks/results/m3/provenance/
!/benchmarks/results/m3/verification/
!/benchmarks/results/m3/verification/verify-retained-logs.py

# Local application samples; maintained fixtures and workloads live elsewhere.
/examples/*
!/examples/README.md
!/examples/__init__.py
!/examples/custom_training.py
!/examples/custom-regression-draft.yaml
!/examples/node.yaml

